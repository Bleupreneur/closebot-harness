# CloseBot harness — environment template
#
# Folder mode: copy to .env and fill in real values
#   cp .env.example .env
#   chmod 600 .env
#   (or run: cli/cb init)
# Plugin mode: run `cb init --global` — writes ~/.config/closebot/.env instead.
#
# .env is gitignored and never committed.
# scripts/smoke.sh auto-loads this file when present.

# REQUIRED — your CloseBot API key (header X-CB-KEY)
# Generate at: https://app.closebot.com/settings?tab=keys (shown once)
# Format: cb_<random>
CLOSEBOT_API_KEY=

# OPTIONAL — your template bot (or set templateBot in cb.config.json)
# CB_TEMPLATE_BOT=bot_XXXXXXXXXXXXXXXX

# OPTIONAL — alternate sandbox allowlist path (default cli/sandbox.json)
# CB_SANDBOX_FILE=cli/sandbox.json

# OPTIONAL — GHL token for scripts/ghl-business-facts.sh (location-scoped PIT or OAuth token)
# GHL_TOKEN=

# OPTIONAL — 1 enables the self-heal skill-retro Stop hook
# CB_SELF_HEAL=0

# OPTIONAL — defaults used by playbooks/examples (uncomment + fill if you want):
# CLOSEBOT_BOT_ID=
# CLOSEBOT_SOURCE_ID=
# CLOSEBOT_LEAD_ID=
