# Closebot — environment template
#
# Copy to .env and fill in real values:
#   cp .env.example .env
#   chmod 600 .env
#
# .env is gitignored and never committed.
# scripts/smoke.sh auto-loads this file when present.

# REQUIRED — your Closebot API key
# Generate at: https://app.closebot.com/settings?tab=keys
# Format: cb_<random>
CLOSEBOT_API_KEY=

# OPTIONAL — defaults used by playbooks/examples (uncomment + fill if you want):
# CLOSEBOT_BOT_ID=
# CLOSEBOT_SOURCE_ID=
# CLOSEBOT_LEAD_ID=
